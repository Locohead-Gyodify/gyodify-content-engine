# GYODIFY Content Engine — Environment Variables
# Copy this to .env for local development
# NEVER commit .env to git — it is in .gitignore

# ── LLM Providers (get free keys from these sites) ──
GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE          # aistudio.google.com
GROQ_API_KEY=gsk_YOUR_KEY_HERE               # console.groq.com
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE       # openrouter.ai (optional)

# ── Telegram ──
TELEGRAM_BOT_TOKEN=7123456789:AAFxyz_YOUR_TOKEN   # from @BotFather
TELEGRAM_CHAT_ID=987654321                         # from scripts/get_chat_id.py

# ── Optional enrichment ──
PEXELS_API_KEY=YOUR_KEY_HERE                 # pexels.com/api (free)
YOUTUBE_API_KEY=YOUR_KEY_HERE                # console.cloud.google.com (free)
